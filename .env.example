# Copy to .env. Restart the processes after editing; rebuild for VITE_* changes.
# Browser backend origin. Empty = same origin (/api), recommended with the proxy.
# Example direct connection: VITE_BACKEND_URL=http://127.0.0.1:8787
VITE_BACKEND_URL=
# Default for browsers with no saved storage-mode preference: local or server.
VITE_DEFAULT_STORAGE_MODE=local

# API listener and storage. Relative paths resolve from this project directory.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/dropzone.sqlite
DIST_PATH=dist

# Dev/preview API proxy target. Empty = derive from HOST and PORT above.
BACKEND_URL=
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
PREVIEW_PORT=4173

# Extra backend Host header names, comma-separated, no scheme or port.
# Loopback names and HOST are already allowed. Add your public domain if needed.
ALLOWED_HOSTS=
# Exact frontend origins for a direct cross-origin VITE_BACKEND_URL connection.
# Example: http://127.0.0.1:5173,http://localhost:5173
# Empty = same-origin only. Never use *; there is no authentication in this app.
ALLOWED_ORIGINS=
